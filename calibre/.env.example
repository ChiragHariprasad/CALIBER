# =============================================================================
# CALIBRE – Environment Configuration
# =============================================================================

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://calibre:calibre@localhost:5432/calibre
DATABASE_URL_SYNC=postgresql://calibre:calibre@localhost:5432/calibre

# --- Redis (optional, disabled by default) ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Replay ---
REPLAY_SPEED=10
REPLAY_DATA_PATH=data/sample

# --- Rules ---
PIT_LANE_SPEED_LIMIT_KMH=60.0

# --- Uncertainty ---
MEASUREMENT_UNCERTAINTY=1.5
PARAMETER_UNCERTAINTY=0.5
UNCERTAINTY_K=2.0

# --- Integrity ---
CUSUM_THRESHOLD=5.0
CUSUM_DRIFT=0.5

# --- Logging ---
LOG_LEVEL=INFO
